---

<Base title="AI 工作流作品集" description="跨境电商团队的 AI 创意生产、团队协作流程、投放数据与 agent 工程，以及个人日更 IP 管线。">
  <article class="aiwf" id="pilot-marker-aiwf">
    <header class="hero">
      <p class="eyebrow">AI 工作流作品集 · 2026-10</p>
      <h1>把团队的活，接成 AI 能执行、能验收的工作流</h1>
      <p class="lede">
        跨境电商品牌增长负责人，2026.03 起主导团队 AI 产品；之前做了 7 年软件研发。下面每一块都是在用的系统，按「解决什么问题 → 流程图 → 结果 → 可以展开聊什么」来写。
      </p>
      <ul class="counts">
        {counts.map(([n, l]) => (
          <li><strong>{n}</strong><span>{l}</span></li>
        ))}
      </ul>
      <nav class="toc" aria-label="本页目录">
        {sections.map((s) => <a href={`#${s.id}`}>{s.kicker}</a>)}
      </nav>
    </header>

    {
      sections.map((s) => (
        <section id={s.id} class="block">
          <p class="kicker">{s.kicker}</p>
          <h2>{s.title}</h2>
          <p class="block-lede">{s.lede}</p>
          <div class="items">
            {s.items.map((it) => (
              <div class="item">
                <h3>{it.title}</h3>
                <p class="problem"><span class="tag">问题</span>{it.problem}</p>

                {it.diagram?.kind === 'steps' && (
                  <ol class="d-steps">
                    {it.diagram.steps.map((st) => (
                      <li>
                        <span class="who">{st.who}</span>
                        <div class="node">
                          <span class="node-t">{st.t}</span>
                          {st.auto && <span class="auto"><b>自动</b>{st.auto}</span>}
                          {st.back && <span class="back"><b>回路</b>{st.back}</span>}
                        </div>
                      </li>
                    ))}
                  </ol>
                )}

                {it.diagram?.kind === 'layers' && (
                  <figure class="d-layers">
                    {it.diagram.layers.map(([name, note]) => (
                      <div class="layer"><span class="layer-n">{name}</span><span class="layer-d">{note}</span></div>
                    ))}
                    <figcaption>{it.diagram.caption}</figcaption>
                  </figure>
                )}

                {it.diagram?.kind === 'fanout' && (
                  <figure class="d-fan">
                    <div class="fan-src">{it.diagram.source}</div>
                    <div class="fan-mid">
                      {it.diagram.branches.map((b) => <div class="fan-b">{b}</div>)}
                    </div>
                    <div class="fan-sink">{it.diagram.sink}</div>
                  </figure>
                )}

                {it.diagram?.kind === 'states' && (
                  <figure class="d-states">
                    <div class="svg-scroll">
                      <svg viewBox="0 0 780 250" role="img" aria-label="脚本状态流转：待分配到待剪辑到等待审核，两签通过为合格，任一需修改则打回待剪辑">
                        <defs>
                          <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                            <path d="M0,0 L10,5 L0,10 z" class="ah" />
                          </marker>
                        </defs>
                        <g class="st st-gray"><rect x="10" y="70" width="110" height="44" rx="22" /><text x="65" y="97">待分配</text></g>
                        <g class="st st-blue"><rect x="200" y="70" width="110" height="44" rx="22" /><text x="255" y="97">待剪辑</text></g>
                        <g class="st st-orange"><rect x="400" y="70" width="130" height="44" rx="22" /><text x="465" y="97">等待审核</text></g>
                        <g class="st st-green"><rect x="640" y="20" width="110" height="44" rx="22" /><text x="695" y="47">合格</text></g>
                        <g class="st st-red"><rect x="640" y="130" width="110" height="44" rx="22" /><text x="695" y="157">需修改</text></g>
                        <path class="edge" d="M120,92 L196,92" marker-end="url(#ah)" />
                        <path class="edge" d="M310,92 L396,92" marker-end="url(#ah)" />
                        <path class="edge" d="M530,85 C580,70 600,50 636,44" marker-end="url(#ah)" />
                        <path class="edge" d="M530,100 C580,115 600,140 636,148" marker-end="url(#ah)" />
                        <path class="edge edge-back" d="M695,174 C695,240 255,240 255,118" marker-end="url(#ah)" />
                        <text class="el" x="160" y="62">组长派活</text>
                        <text class="el" x="353" y="62">剪辑交片</text>
                        <text class="el" x="580" y="30">两签通过</text>
                        <text class="el" x="578" y="178">任一打回</text>
                        <text class="el el-back" x="475" y="232">写意见，剪辑收到红色通知，改完重传</text>
                      </svg>
                    </div>
                    <figcaption>三种角色：创意建行，组长派活和审核，剪辑交片。每个箭头都自动通知下一环节的人。</figcaption>
                  </figure>
                )}

                {it.diagram?.kind === 'gallery' && (
                  <figure class="d-gallery">
                    <div class="gal" tabindex="0" aria-label="操作说明视频分镜，可横向滑动">
                      {GALLERY.map(([n, cap]) => (
                        <figure class="shot">
                          <img src={url(`works-media/script-desk/${n}.jpg`)} alt={cap} loading="lazy" width="1280" height="720" />
                          <figcaption><span class="shot-n">{n}</span>{cap}</figcaption>
                        </figure>
                      ))}
                    </div>
                    <figcaption class="gal-cap">横向滑动看全部 12 步。原片约 90 秒。</figcaption>
                  </figure>
                )}

                {it.flow && (
                  <ol class="flow" aria-label="工作流">
                    {it.flow.map((f) => <li>{f}</li>)}
                  </ol>
                )}

                <ul class="result">
                  {it.result.map((r) => <li>{r}</li>)}
                </ul>
                <p class="talk">{it.talk}</p>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <p class="note">
      数字口径：计数来自系统记录或本人统计（已注明）；出单为平台归因。公开页不放金额，成本只给比例；团队流程里的人写成角色，说明视频里的人名和数字是示意。
    </p>
  </article>
</Base>

<style>
  .aiwf {
    --ok: #1f9d55;
    --warn: #e07a00;
    --bad: var(--wrong);
    padding-block: 8px 48px;
  }
  .hero {
    padding-block: 24px 8px;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow,
  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin: 0 0 8px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 6vw, 46px);
    line-height: 1.2;
    margin: 0 0 16px;
    text-wrap: balance;
  }
  .lede {
    max-width: 40em;
    margin: 0 0 24px;
  }
  .counts {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .counts li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  .counts strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.1;
    color: var(--field);
    font-variant-numeric: tabular-nums;
  }
  .counts span {
    font-size: 14px;
    color: var(--ink-soft);
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding-block: 4px 16px;
    font-size: 15px;
  }
  .block {
    padding-block: 40px 8px;
    scroll-margin-top: 16px;
  }
  .block h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(24px, 4.4vw, 32px);
    line-height: 1.25;
    margin: 0 0 8px;
    text-wrap: balance;
  }
  .block h2::after {
    content: '';
    display: block;
    width: 56px;
    height: 6px;
    margin-top: 8px;
    background: var(--marker);
  }
  .block-lede {
    max-width: 40em;
    color: var(--ink-soft);
    margin: 0 0 20px;
  }
  .items {
    display: grid;
    gap: 16px;
  }
  .item {
    min-width: 0;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  .item h3 {
    font-size: 19px;
    margin: 0 0 10px;
  }
  .problem {
    margin: 0 0 16px;
  }
  .tag {
    display: inline-block;
    margin-right: 8px;
    padding: 0 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    color: var(--card);
    background: var(--ink);
    border-radius: 3px;
    vertical-align: 2px;
  }
  figure {
    margin: 0;
  }

  /* 纵向流程：左侧角色，右侧节点，节点之间一条竖线 */
  .d-steps {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .d-steps li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 10px;
    position: relative;
    padding-bottom: 14px;
  }
  .d-steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(64px + 10px + 13px);
    top: 30px;
    bottom: 0;
    border-left: 2px solid var(--field);
    opacity: 0.35;
  }
  .who {
    align-self: start;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.3;
    color: var(--ink-soft);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .node {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 6px 0 0 30px;
    position: relative;
  }
  .node::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 10px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--card);
    border: 3px solid var(--field);
  }
  .node-t {
    font-weight: 600;
    line-height: 1.5;
  }
  .auto,
  .back {
    font-size: 14px;
    line-height: 1.5;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .auto {
    background: var(--light);
    color: var(--ink);
  }
  .back {
    border: 1px dashed var(--bad);
    color: var(--ink);
  }
  .auto b,
  .back b {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    margin-right: 8px;
    padding: 0 5px;
    border-radius: 3px;
    color: var(--card);
  }
  .auto b {
    background: var(--field);
  }
  .back b {
    background: var(--bad);
  }

  /* 分层架构 */
  .d-layers {
    display: grid;
    gap: 6px;
    margin-bottom: 16px;
  }
  .layer {
    display: grid;
    grid-template-columns: minmax(84px, 120px) minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 4px;
    background: var(--light);
    border-left: 4px solid var(--field);
  }
  .layer-n {
    font-weight: 700;
    color: var(--field);
  }
  .layer-d {
    font-size: 15px;
    min-width: 0;
  }
  .d-layers figcaption,
  .d-states figcaption,
  .gal-cap {
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  /* 扇出 */
  .d-fan {
    display: grid;
    gap: 10px;
    justify-items: center;
    margin-bottom: 16px;
  }
  .fan-src,
  .fan-sink {
    padding: 8px 14px;
    border-radius: 4px;
    font-weight: 600;
    text-align: center;
    max-width: 100%;
  }
  .fan-src {
    background: var(--ink);
    color: var(--card);
  }
  .fan-sink {
    background: var(--marker);
    color: var(--ink);
  }
  .fan-mid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 8px;
    padding-block: 18px;
    position: relative;
  }
  .fan-mid::before,
  .fan-mid::after {
    content: '↓';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ink-soft);
    line-height: 1;
  }
  .fan-mid::before {
    top: 0;
  }
  .fan-mid::after {
    bottom: 0;
  }
  .fan-b {
    min-width: 0;
    padding: 8px 10px;
    font-size: 14px;
    line-height: 1.5;
    border: 1px solid var(--field);
    border-radius: 4px;
    background: var(--card);
  }

  /* 状态机 */
  .d-states {
    margin-bottom: 16px;
  }
  .svg-scroll {
    overflow-x: auto;
  }
  .svg-scroll svg {
    display: block;
    width: 100%;
    min-width: 620px;
    height: auto;
  }
  .st rect {
    stroke-width: 2;
  }
  .st text {
    font-size: 17px;
    font-weight: 700;
    text-anchor: middle;
    font-family: var(--font-body);
  }
  .st-gray rect { fill: var(--light); stroke: var(--ink-soft); }
  .st-gray text { fill: var(--ink-soft); }
  .st-blue rect { fill: var(--card); stroke: var(--field); }
  .st-blue text { fill: var(--field); }
  .st-orange rect { fill: var(--card); stroke: var(--warn); }
  .st-orange text { fill: var(--warn); }
  .st-green rect { fill: var(--card); stroke: var(--ok); }
  .st-green text { fill: var(--ok); }
  .st-red rect { fill: var(--card); stroke: var(--bad); }
  .st-red text { fill: var(--bad); }
  .edge {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 2;
  }
  .edge-back {
    stroke: var(--bad);
    stroke-dasharray: 6 5;
  }
  .ah {
    fill: var(--ink-soft);
  }
  .el {
    font-size: 13px;
    fill: var(--ink);
    text-anchor: middle;
    font-family: var(--font-body);
  }
  .el-back {
    fill: var(--bad);
  }

  /* 分镜画廊 */
  .d-gallery {
    margin-bottom: 16px;
  }
  .gal {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 78%);
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
  }
  .gal:focus-visible {
    outline: 2px solid var(--field);
    outline-offset: 2px;
  }
  .shot {
    scroll-snap-align: start;
    min-width: 0;
  }
  .shot img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--light);
  }
  .shot figcaption {
    font-size: 14px;
    line-height: 1.5;
    margin-top: 6px;
  }
  .shot-n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-soft);
    margin-right: 8px;
  }

  .flow {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    font-size: 14px;
  }
  .flow li {
    display: flex;
    align-items: center;
    color: var(--field);
  }
  .flow li:not(:last-child)::after {
    content: '→';
    margin: 0 8px;
    color: var(--ink-soft);
  }
  .result {
    margin: 0 0 14px;
    padding-left: 1.2em;
  }
  .result li + li {
    margin-top: 4px;
  }
  .talk {
    margin: 0;
    padding: 10px 12px;
    font-size: 15px;
    background: var(--light-deep);
    border-radius: 4px;
