---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';

// AI 工作流作品集（面试展示用的单独路由，不进导航）。
// 底本：2026-10-16 AI 版详细简历 + 2026-10-18 数字审计口径；2026-10 近期工作补在最后一块。
// 公开站发布闸会拦品牌词、真名和业务金额，所以金额一律换成比例或计数；团队流程里的人一律写角色。

type Step = { t: string; who?: string; auto?: string; back?: string };
type Diagram =
  | { kind: 'steps'; steps: Step[] }
  | { kind: 'layers'; caption: string; layers: [string, string][] }
  | { kind: 'fanout'; source: string; branches: string[]; sink: string }
  | { kind: 'states' }
  | { kind: 'gallery' };

type Item = {
  title: string;
  problem: string;
  diagram?: Diagram;
  flow?: string[];
  result: string[];
  talk: string;
};

type Section = { id: string; kicker: string; title: string; lede: string; items: Item[] };

const GALLERY = [
  ['01', '一张表，从脚本走到出单'],
  ['02', '创意在自己组的视图里新建一行'],
  ['03', '组长填「剪辑分配」，剪辑马上收到飞书通知'],
  ['04', '剪辑每天 10:00 看待办卡，被打回的排最前'],
  ['05', '传成片，自动变「等待审核」并提醒组长'],
  ['06', '创意审、组长审都通过才算合格'],
  ['07', '任一人选「需修改」并写意见，立刻打回'],
  ['08', '改写或重剪建「子记录」，编号自动变成原编号-2'],
  ['09', '发片标题带完整编号，编号是出单归因的钥匙'],
  ['10', '系统每天按编号把出单和投放状态写回这一行'],
  ['11', '看板按「排期 = 今天」统计，巡检每小时报警'],
  ['12', '每个人只管自己那一步'],
] as const;

const sections: Section[] = [
  {
    id: 'sec-harness',
    kicker: 'Agent 工程底座',
    title: '让 AI 按规矩干活：Claude Code harness',
    lede: '所有业务工作流都跑在同一套自建的 agent 底座上。核心思路是分层、职责单一、按需加载，能机器强制的就不靠提示词。',
    items: [
      {
        title: '分层架构',
        problem: '规则、流程、状态和外部数据混在一份提示词里，越写越长，模型越来越不听。',
        diagram: {
          kind: 'layers',
          caption: '一条新约束从上往下找第一个能落的层：能被机器挡住的，不写进文档',
