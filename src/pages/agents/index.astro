---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { POST_COLUMNS } from '../../lib/site';

const c = POST_COLUMNS.agents;
const entries = await getCollection('agents');
---

<Base title={c.title} description={c.blurb}>
  <h1>{c.title}</h1>
  <p class="muted">{c.blurb}</p>
  <PostList column="agents" entries={entries} />
</Base>
