---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate, url } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('brandlab');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={d.summary}>
  <p class="meta">
    <a href={url('brandlab/')}>← 品牌拆解库</a> · {d.brand} · {d.category} · {fmtDate(d.date)}
    {d.sample && ' · 示例数据'}
  </p>
  <h1>{d.title}</h1>
  <p class="muted">{d.summary}</p>
  <p>{d.tags.map((t) => <span class="tag">{t}</span>)}</p>
  <article class="prose">
    <Content />
  </article>
</Base>
